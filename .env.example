# Notion 연동 (서버 전용 - 클라이언트에 노출 금지)
# https://www.notion.so/my-integrations 에서 통합을 만들고 토큰을 발급받으세요.
NOTION_API_KEY=ntn_your_api_key_here

# 견적서 데이터가 저장된 Notion 데이터베이스 ID
NOTION_DATABASE_ID=

# 발행자(사업자) 정보 - Notion에 별도 DB가 없어 환경 변수로 고정 관리한다.
# BUSINESS_NAME이 없으면 발행자 정보는 표시되지 않는다.
BUSINESS_NAME=
BUSINESS_OWNER_NAME=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_TAX_ID=

# 관리자 목록의 공개 링크 복사(Task 015)에서 서버 렌더링 시 사용하는 사이트 기본 도메인.
# 클라이언트에 노출되는 값이라 NEXT_PUBLIC_ 접두사를 쓴다. 비워두면 요청 origin으로 폴백한다.
NEXT_PUBLIC_SITE_URL=

# 관리자 인증(Task 018, A005) - /admin은 이 두 값이 없으면 앱이 시작되지 않는다.

# 관리자 비밀번호의 scrypt 해시(salt:hash, 각각 hex). 아래 명령의 '원하는비밀번호'를 바꿔 실행한 뒤
# 출력값을 그대로 붙여넣으세요.
# node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" '원하는비밀번호'
ADMIN_PASSWORD_HASH=

# 세션 쿠키(JWT) 서명 키. 32자 이상 무작위 문자열.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
